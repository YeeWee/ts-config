{
  "name": "ts-config-example",
  "private": true,
  "type": "module",
  "prettier": "@yeewee/ts-config/prettier",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "lint:boundaries": "depcruise src/packages",
    "lint": "pnpm lint:eslint && pnpm lint:boundaries",
    "format:check": "prettier --check .",
    "test": "node --test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@yeewee/ts-config": "workspace:*",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "typescript": "~6.0.3"
  }
}
